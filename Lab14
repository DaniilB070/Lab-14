#include <stdio.h>

int main()
{
    // ========== Задание 1 ==========
    // Определить объём памяти, выделяемой под указатель
    // на переменные типа char, int, double

    char  *pc;
    int   *pi;
    double *pd;

    printf("Размер указателя на char:   %zu байт\n", sizeof(pc));
    printf("Размер указателя на int:    %zu байт\n", sizeof(pi));
    printf("Размер указателя на double: %zu байт\n", sizeof(pd));

    // Пример из методички:
    int *pi2, i = 5;
    float *pf, f = 2.1f;
    printf("sizeof(pi) = %lu\n", (unsigned long)sizeof(pi2));
    printf("sizeof(pf) = %lu\n", (unsigned long)sizeof(pf));

    printf("\n");

    // ========== Задание 2 ==========
    // Проанализировать приведённый ниже код. Объяснить результат.

    float PI = 3.14159f, *p1, *p2;
    p1 = p2 = &PI;

    printf("По адресу p1 = %p хранится *p1 = %f\n", (void*)p1, *p1);
    printf("По адресу p2 = %p хранится *p2 = %f\n", (void*)p2, *p2);

    // Для наглядности можно вывести адреса в шестнадцатеричном виде:
    printf("p1 = %x, *p1 = %f\n", (unsigned int)(uintptr_t)p1, *p1);
    printf("p2 = %x, *p2 = %f\n", (unsigned int)(uintptr_t)p2, *p2);

    return 0;
}
