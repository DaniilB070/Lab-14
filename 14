#define _CRT_SECURE_NO_WARNINGS   // чтобы VS не ругался на scanf
#include <stdio.h>
#include <locale.h>
#include <stdlib.h>
#include <stdint.h>

// ========== Вспомогательная функция для паузы ==========
void pause() {
    printf("\nНажмите Enter для продолжения...");
    getchar();
}

int main()
{
    // ---------- Поддержка русского языка ----------
    setlocale(LC_ALL, "Russian");
    system("chcp 1251 > nul");   // для правильного отображения кириллицы в консоли Windows

    printf("==================================================\n");
    printf("   Лабораторная работа 14. Работа с указателями\n");
    printf("==================================================\n\n");

    // ==================================================
    // ЗАДАНИЕ 1. Объём памяти, выделяемой под указатель
    // ==================================================
    printf(">>> ЗАДАНИЕ 1. Размер указателей разных типов\n\n");

    char*   pc;
    int*    pi;
    float*  pf;
    double* pd;

    printf("Размер указателя на char:   %zu байт\n", sizeof(pc));
    printf("Размер указателя на int:    %zu байт\n", sizeof(pi));
    printf("Размер указателя на float:  %zu байт\n", sizeof(pf));
    printf("Размер указателя на double: %zu байт\n", sizeof(pd));

    printf("\nВывод: размер самого указателя (адреса) одинаков для всех типов\n");
    printf("и зависит только от разрядности системы (обычно 4 или 8 байт).\n");

    pause();

    // ==================================================
    // ЗАДАНИЕ 2. Два указателя на одну переменную
    // ==================================================
    printf("\n>>> ЗАДАНИЕ 2. Два указателя на одну переменную\n\n");

    float PI = 3.14159f, *p1, *p2;
    p1 = p2 = &PI;

    printf("По адресу p1 = %p хранится *p1 = %f\n", (void*)p1, *p1);
    printf("По адресу p2 = %p хранится *p2 = %f\n", (void*)p2, *p2);

    printf("\nОбъяснение: оба указателя содержат один и тот же адрес.\n");
    printf("Поэтому *p1 и *p2 дают одно и то же значение.\n");

    pause();

    // ==================================================
    // ЗАДАНИЕ 3. Инкремент / декремент указателя
    // ==================================================
    printf("\n>>> ЗАДАНИЕ 3. Инкремент и декремент указателя\n\n");

    // --- int ---
    {
        int x = 5;
        int* pa = &x;

        printf("--- Тип int ---\n");
        printf("До:     адрес = %p, значение = %d\n", (void*)pa, *pa);
        pa++;
        printf("pa++:   адрес = %p, значение = %d  (сдвиг на %zu байт)\n",
            (void*)pa, *pa, sizeof(int));
        pa--;
        printf("pa--:   адрес = %p, значение = %d\n", (void*)pa, *pa);
    }

    // --- double ---
    {
        double x = 5.0;
        double* pa = &x;

        printf("\n--- Тип double ---\n");
        printf("До:     адрес = %p, значение = %g\n", (void*)pa, *pa);
        pa++;
        printf("pa++:   адрес = %p, значение = %g  (сдвиг на %zu байт)\n",
            (void*)pa, *pa, sizeof(double));
        pa--;
        printf("pa--:   адрес = %p, значение = %g\n", (void*)pa, *pa);
    }

    // --- char ---
    {
        char x = 'A';
        char* pa = &x;

        printf("\n--- Тип char ---\n");
        printf("До:     адрес = %p, значение = %c\n", (void*)pa, *pa);
        pa++;
        printf("pa++:   адрес = %p, значение = %c  (сдвиг на %zu байт)\n",
            (void*)pa, *pa, sizeof(char));
        pa--;
        printf("pa--:   адрес = %p, значение = %c\n", (void*)pa, *pa);
    }

    printf("\nВывод: при pa++ / pa-- указатель сдвигается на sizeof(тип) байт.\n");

    pause();

    // ==================================================
    // ЗАДАНИЕ 4. Перемещение по массиву с помощью указателя
    // ==================================================
    printf("\n>>> ЗАДАНИЕ 4. Перемещение по массиву указателем\n\n");

    float array[10] = { 1.1f, 2.2f, 3.3f, 4.4f, 5.5f, 6.6f, 7.7f, 8.8f, 9.9f, 10.0f };
    float* ptr_a;

    // 1. Имя массива — это его адрес
    printf("1. Имя массива является адресом его начала:\n");
    printf("   array     = %p\n", (void*)array);
    printf("   &array[0] = %p\n", (void*)&array[0]);
    printf("   &array    = %p\n", (void*)&array);

    // 2. Указатель на начало + операции
    ptr_a = array;   // то же самое, что &array[0]

    printf("\n2. Перемещение указателя:\n");
    printf("   ptr_a     = %p, *ptr_a = %.1f\n", (void*)ptr_a, *ptr_a);

    ptr_a++;
    printf("   ptr_a++   = %p, *ptr_a = %.1f\n", (void*)ptr_a, *ptr_a);

    ptr_a += 4;
    printf("   ptr_a +=4 = %p, *ptr_a = %.1f\n", (void*)ptr_a, *ptr_a);

    ptr_a -= 2;
    printf("   ptr_a -=2 = %p, *ptr_a = %.1f\n", (void*)ptr_a, *ptr_a);

    // 3. Проход по массиву с шагом 2
    printf("\n3. Проход по массиву с шагом 2 (прямой порядок):\n");
    ptr_a = array;
    for (int i = 0; i < 10; i += 2) {
        printf("   [%d] адрес = %p, значение = %.1f\n", i, (void*)ptr_a, *ptr_a);
        ptr_a += 2;
    }

    // 4. Проход в обратном порядке
    printf("\n4. Проход по массиву в обратном порядке:\n");
    ptr_a = array + 9;   // указатель на последний элемент
    for (int i = 9; i >= 0; i--) {
        printf("   [%d] адрес = %p, значение = %.1f\n", i, (void*)ptr_a, *ptr_a);
        ptr_a--;
    }

    pause();

    // ==================================================
    // ЗАДАНИЕ 5. Побайтовый вывод целого числа (endianness)
    // ==================================================
    printf("\n>>> ЗАДАНИЕ 5. Побайтовый вывод целого числа\n\n");

    int x = 0x12345678;
    int* prt = &x;
    unsigned char* a = (unsigned char*)prt;

    unsigned char* a1 = a + 3;
    unsigned char* a2 = a + 2;
    unsigned char* a3 = a + 1;
    unsigned char* a4 = a;

    printf("Число x = 0x%X\n", x);
    printf("Байты в памяти (от младшего адреса к старшему):\n");
    printf("%02X %02X %02X %02X\n", *a4, *a3, *a2, *a1);

    printf("\nЕсли выводится 78 56 34 12  →  little-endian (прямое размещение)\n");
    printf("Если выводится 12 34 56 78  →  big-endian   (обратное размещение)\n");

    // Современный способ определения порядка байт
    uint32_t test = 0x01020304;
    unsigned char* bytes = (unsigned char*)&test;
    if (bytes[0] == 0x04)
        printf("\nВаша система: little-endian\n");
    else
        printf("\nВаша система: big-endian\n");

    pause();

    // ==================================================
    // ЗАДАНИЕ **. Размеры типов БЕЗ sizeof и констант
    // ==================================================
    printf("\n>>> ЗАДАНИЕ **. Размеры типов без sizeof\n\n");
    printf("(используется трюк с разностью адресов соседних элементов массива)\n\n");

    // Макрос, который вычисляет размер типа через разность адресов
#define SIZEOF(type)  ((char*)(&((type*)0)[1]) - (char*)(&((type*)0)[0]))

    printf("char:            %td байт\n", SIZEOF(char));
    printf("short:           %td байт\n", SIZEOF(short));
    printf("int:             %td байт\n", SIZEOF(int));
    printf("long:            %td байт\n", SIZEOF(long));
    printf("long long:       %td байт\n", SIZEOF(long long));
    printf("float:           %td байт\n", SIZEOF(float));
    printf("double:          %td байт\n", SIZEOF(double));
    printf("long double:     %td байт\n", SIZEOF(long double));
    printf("size_t:          %td байт\n", SIZEOF(size_t));
    printf("wchar_t:         %td байт\n", SIZEOF(wchar_t));
    printf("void*:           %td байт\n", SIZEOF(void*));

    printf("\n==================================================\n");
    printf("           Все задания выполнены!\n");
    printf("==================================================\n");

    return 0;
}
